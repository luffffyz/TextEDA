{
  "name": "texteda",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/luffffyz/TextEDA.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "bun run --cwd packages/ir gen",
    "gen:check": "bun run --cwd packages/ir gen --check",
    "test": "bun test",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/ir --noEmit && tsc -p packages/exporter --noEmit && tsc -p packages/parser --noEmit && tsc -p packages/renderer --noEmit && tsc -p packages/cli --noEmit",
    "texteda": "bun run packages/cli/scripts/texteda.ts",
    "check:links": "bun run scripts/check-links.ts",
    "check:public": "bun run scripts/check-public.ts",
    "lib:hash": "bun run scripts/libhash.ts",
    "migrate:0.7": "bun run scripts/migrate-0.7.ts",
    "lib:verify": "bun run scripts/verify-libs.ts",
    "lib:verify:kicad": "bun run scripts/verify-libs.ts --kicad",
    "export:footprint": "bun run packages/exporter/scripts/export-footprint.ts",
    "smoke:footprint": "bun run scripts/smoke-footprint.ts",
    "compile:footprint": "bun run packages/parser/scripts/compile-footprint.ts",
    "compile:symbol": "bun run packages/parser/scripts/compile-symbol.ts",
    "compile:schematic": "bun run packages/cli/scripts/texteda.ts compile",
    "export:symbol": "bun run scripts/export-symbol.ts",
    "fmt:teda": "bun run packages/parser/scripts/fmt-teda.ts",
    "smoke:symbol": "bun run scripts/smoke-symbol.ts",
    "preview": "bun run scripts/preview.ts",
    "check": "bun run packages/cli/scripts/texteda.ts check",
    "ir": "bun run packages/cli/scripts/texteda.ts ir"
  },
  "devDependencies": {
    "@texteda/exporter": "workspace:*",
    "@texteda/ir": "workspace:*",
    "@texteda/parser": "workspace:*",
    "@texteda/renderer": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.10.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.2"
  }
}
