{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.14:pcb",
  "title": "TextEDA IR v0.14 — pcb shard",
  "description": "Physical facts and rule intent of one board (layer B0). No drawing parameters, silkscreen layout, fill caches or UUIDs; connectivity is decided by connect and the schematic and is never back-derived from geometry. See ADR-0115, spec/pcb.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "format", "board", "board_thickness_nm", "stackup", "outline", "place", "connect", "rules"],
  "properties": {
    "ir_version": { "$ref": "urn:texteda:ir:0.14:common#/$defs/ir_version" },
    "format": { "$ref": "urn:texteda:ir:0.14:common#/$defs/format_version" },
    "source": { "$ref": "urn:texteda:ir:0.14:common#/$defs/source_ref" },
    "board": { "$ref": "urn:texteda:ir:0.14:common#/$defs/slug" },
    "board_thickness_nm": {
      "type": "integer",
      "minimum": 1,
      "description": "Total board thickness; matches the sum of the stackup layer thicknesses (solder-mask and silkscreen layers excluded)."
    },
    "stackup": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/stackup_layer" },
      "description": "Order is top to bottom; not sorted. The first and last entries must be copper layers."
    },
    "outline": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" },
      "description": "Closed board-outline polyline (closed automatically from first to last); only polylines are supported. The coordinate origin is the lower-left corner of the outline's bounding box."
    },
    "place": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement" },
      "description": "Where the placed instances sit, one entry per instance."
    },
    "connect": {
      "type": "array",
      "items": { "$ref": "#/$defs/connect_edge" },
      "description": "Explicitly declares which two pads have continuous copper between them — one of the sources of truth for connectivity."
    },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/$defs/trace" },
      "description": "The tracks: pieces of copper of one net on one layer."
    },
    "via": {
      "type": "array",
      "items": { "$ref": "#/$defs/via" },
      "description": "The vias: holes from one layer to another."
    },
    "zone": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" },
      "description": "The copper zones (pours)."
    },
    "keepout": {
      "type": "array",
      "items": { "$ref": "#/$defs/keepout" },
      "description": "The regions where something may not be put."
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "description": "Design rules must enter the IR: KiCad keeps them in the project file rather than the board file, so an agent holding only the .kicad_pcb cannot check them itself."
    },
    "silk": {
      "type": "array",
      "items": { "$ref": "#/$defs/silk" },
      "description": "The silkscreen items."
    },
    "physical_only": {
      "type": "array",
      "items": { "$ref": "#/$defs/physical_only" },
      "description": "The items that exist on the board but not in the schematic."
    },
    "deviation": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" },
      "description": "The controlled deviations between the schematic and the board."
    },
    "note": { "$ref": "urn:texteda:ir:0.14:common#/$defs/note" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer", "description": "X coordinate, nanometres from the origin." },
        "y_nm": { "type": "integer", "description": "Y coordinate, nanometres from the origin." }
      },
      "description": "A point on the board, in nanometres from the origin."
    },
    "stackup_layer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "type", "thickness_nm", "kind"],
          "properties": {
            "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
            "type": { "const": "copper", "description": "The kind of layer: copper." },
            "thickness_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Thickness of the copper, nanometres."
            },
            "kind": {
              "enum": ["signal", "power", "plane"],
              "description": "What the copper layer is for."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "type", "thickness_nm", "material"],
          "properties": {
            "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
            "type": { "const": "dielectric", "description": "The kind of layer: dielectric." },
            "thickness_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Thickness of the dielectric, nanometres."
            },
            "material": {
              "type": "string",
              "minLength": 1,
              "description": "The dielectric material."
            },
            "er_ppm": {
              "type": "integer",
              "minimum": 1000000,
              "description": "Dielectric constant × 10^6, e.g. FR4 4.3 = 4300000; omitted means unknown."
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "x_nm", "y_nm", "rot_mdeg", "side"],
      "properties": {
        "instance_id": { "$ref": "urn:texteda:ir:0.14:common#/$defs/instance_id" },
        "x_nm": {
          "type": "integer",
          "description": "X coordinate of the instance's origin, nanometres."
        },
        "y_nm": {
          "type": "integer",
          "description": "Y coordinate of the instance's origin, nanometres."
        },
        "rot_mdeg": {
          "type": "integer",
          "description": "Clockwise positive, millidegrees; reduced modulo 360000."
        },
        "side": {
          "enum": ["top", "bottom"],
          "description": "Which side of the board the instance sits on."
        }
      },
      "description": "Where a placed instance sits on the board."
    },
    "connect_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "urn:texteda:ir:0.14:common#/$defs/pad_ref" },
        "b": { "$ref": "urn:texteda:ir:0.14:common#/$defs/pad_ref" }
      },
      "description": "A pad pair forms an edge \"connected by copper\"; within each pair, byte order a ≤ b."
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "layer", "width_nm", "points"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
        "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
        "width_nm": { "type": "integer", "minimum": 1, "description": "Track width, nanometres." },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" },
          "description": "The track's centre line, at least two points."
        }
      },
      "description": "A track: a piece of copper of one net on one layer."
    },
    "via": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "x_nm", "y_nm", "size_nm", "drill_nm"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
        "x_nm": {
          "type": "integer",
          "description": "X coordinate of the via's centre, nanometres."
        },
        "y_nm": {
          "type": "integer",
          "description": "Y coordinate of the via's centre, nanometres."
        },
        "size_nm": {
          "type": "integer",
          "minimum": 1,
          "description": "Outer diameter of the via's pad, nanometres."
        },
        "drill_nm": {
          "type": "integer",
          "minimum": 1,
          "description": "Diameter of the drilled hole, nanometres."
        },
        "from_layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
        "to_layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" }
      },
      "dependentRequired": {
        "from_layer": ["to_layer"],
        "to_layer": ["from_layer"]
      },
      "description": "Omitting from_layer/to_layer means a through hole; when given, it is a blind/buried via."
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "layer", "points"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
        "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" },
          "description": "The outline of the zone, at least three points; the polygon is closed implicitly."
        }
      },
      "description": "Only the intent is stored (outline + net + layer); the fill result never enters the IR and is recomputed from the outline + rules."
    },
    "keepout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "layer", "points"],
      "properties": {
        "type": {
          "enum": ["no_track", "no_pour", "no_place", "no_via"],
          "description": "What the keepout forbids."
        },
        "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" },
          "description": "The outline of the keepout, at least three points; the polygon is closed implicitly."
        }
      },
      "description": "A region where something may not be put."
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": {
              "const": "clearance",
              "description": "The kind of rule: minimum clearance between copper of different nets."
            },
            "value_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "The clearance, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": { "const": "width", "description": "The kind of rule: default track width." },
            "value_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "The track width, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "size_nm", "drill_nm"],
          "properties": {
            "type": { "const": "via", "description": "The kind of rule: default via geometry." },
            "size_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Outer diameter of the via's pad, nanometres."
            },
            "drill_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the drilled hole, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net", "clearance_nm", "width_nm", "via_size_nm", "via_drill_nm"],
          "properties": {
            "type": {
              "const": "net",
              "description": "The kind of rule: the overrides for one net."
            },
            "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "clearance_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Clearance on this net, nanometres."
            },
            "width_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Track width on this net, nanometres."
            },
            "via_size_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Via pad diameter on this net, nanometres."
            },
            "via_drill_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Via drill diameter on this net, nanometres."
            }
          },
          "description": "Overrides the default per net; the value must be written out in full — there is no \"inherit\"."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b", "impedance_mohm", "gap_nm"],
          "properties": {
            "type": { "const": "diff", "description": "The kind of rule: a differential pair." },
            "net_a": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "impedance_mohm": {
              "type": "integer",
              "minimum": 1,
              "description": "Target differential impedance, milliohms."
            },
            "gap_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Gap between the two traces of the pair, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b", "max_delta_nm"],
          "properties": {
            "type": {
              "const": "match",
              "description": "The kind of rule: length matching between two nets."
            },
            "net_a": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "max_delta_nm": {
              "type": "integer",
              "minimum": 0,
              "description": "How much the two lengths may differ, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expansion_nm"],
          "properties": {
            "type": { "const": "mask", "description": "The kind of rule: solder mask opening." },
            "expansion_nm": {
              "type": "integer",
              "minimum": 0,
              "description": "How much the mask opening grows beyond the pad, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ratio_ppm", "offset_nm"],
          "properties": {
            "type": { "const": "paste", "description": "The kind of rule: solder paste stencil." },
            "ratio_ppm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Paste area as a fraction of the pad area, parts per million."
            },
            "offset_nm": {
              "type": "integer",
              "description": "Offset of the stencil aperture from the pad, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "gap_nm", "bridge_nm"],
          "properties": {
            "type": {
              "const": "thermal",
              "description": "The kind of rule: thermal relief under a pad."
            },
            "gap_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Gap between the thermal spokes, nanometres."
            },
            "bridge_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Width of the thermal spokes, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": {
              "const": "min_width",
              "description": "The kind of rule: the narrowest track the board accepts."
            },
            "value_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "The minimum track width, nanometres."
            }
          }
        }
      ],
      "description": "A manufacturing rule the board must satisfy."
    },
    "silk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "layer", "size_nm", "mode"],
      "properties": {
        "item": {
          "enum": ["refdes", "value"],
          "description": "The silkscreen item (a line, an arc or a text)."
        },
        "layer": {
          "enum": ["F.SilkS", "B.SilkS"],
          "description": "The layer the silkscreen is drawn on."
        },
        "size_nm": {
          "type": "integer",
          "minimum": 1,
          "description": "Stroke or text size, nanometres."
        },
        "mode": {
          "enum": ["show", "hide"],
          "description": "How the item is drawn."
        }
      },
      "description": "A silkscreen item."
    },
    "physical_only": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "x_nm", "y_nm", "size_nm", "drill_nm"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]+$",
              "description": "The item's id, unique in the board."
            },
            "x_nm": {
              "type": "integer",
              "description": "X of the hole centre, nanometres, board frame, y grows downward."
            },
            "y_nm": {
              "type": "integer",
              "description": "Y of the hole centre, nanometres, board frame, y grows downward."
            },
            "type": { "const": "mounting", "description": "What the item is: a mounting hole." },
            "size_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the annular ring, nanometres."
            },
            "drill_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the drilled hole, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "x_nm", "y_nm", "size_nm", "layer"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]+$",
              "description": "The item's id, unique in the board."
            },
            "x_nm": {
              "type": "integer",
              "description": "X of the fiducial centre, nanometres, board frame, y grows downward."
            },
            "y_nm": {
              "type": "integer",
              "description": "Y of the fiducial centre, nanometres, board frame, y grows downward."
            },
            "type": { "const": "fiducial", "description": "What the item is: a fiducial mark." },
            "size_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the mark, nanometres."
            },
            "layer": { "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "x_nm", "y_nm", "net", "size_nm", "drill_nm"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]+$",
              "description": "The item's id, unique in the board."
            },
            "x_nm": {
              "type": "integer",
              "description": "X of the via centre, nanometres, board frame, y grows downward."
            },
            "y_nm": {
              "type": "integer",
              "description": "Y of the via centre, nanometres, board frame, y grows downward."
            },
            "type": { "const": "stitching", "description": "What the item is: a stitching via." },
            "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "size_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the via's pad, nanometres."
            },
            "drill_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Diameter of the drilled hole, nanometres."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "x_nm", "y_nm", "w_nm", "h_nm"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]+$",
              "description": "The item's id, unique in the board."
            },
            "type": {
              "const": "cutout",
              "description": "What the item is: a cutout in the board."
            },
            "x_nm": {
              "type": "integer",
              "description": "X coordinate of the cutout's lower-left corner, nanometres."
            },
            "y_nm": {
              "type": "integer",
              "description": "Y coordinate of the cutout's lower-left corner, nanometres."
            },
            "w_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Width of the cutout, nanometres."
            },
            "h_nm": {
              "type": "integer",
              "minimum": 1,
              "description": "Height of the cutout, nanometres."
            }
          }
        }
      ],
      "description": "Something that exists on the board but not in the schematic."
    },
    "deviation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b"],
          "properties": {
            "type": {
              "const": "net_tie",
              "description": "The kind of deviation: two schematic nets are shorted together."
            },
            "net_a": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" }
          },
          "description": "Two sch nets are physically shorted together."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net"],
          "properties": {
            "type": {
              "const": "split_ground",
              "description": "The kind of deviation: one schematic net is split into disconnected regions."
            },
            "net": { "$ref": "urn:texteda:ir:0.14:common#/$defs/net_id" }
          },
          "description": "One sch net is physically split into mutually disconnected regions."
        }
      ],
      "description": "A controlled deviation between the schematic and the board."
    }
  }
}
