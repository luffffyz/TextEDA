{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.14:symbol",
  "title": "TextEDA IR v0.14 — symbol",
  "description": "**View** of one symbol in a self-built symbol library: pin placement, outline, unit grouping, display toggles. Pin name/number/electrical type belong to `component` (single owner, ADR-0031); this shard only describes how to draw. Lengths are always integer nanometers, angles integer millidegrees (ADR-0005 decision 3); +x right, +y up (KiCad symbol convention).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "symbol"
  ],
  "properties": {
    "ir_version": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/ir_version",
      "description": "IR contract version, currently always 0.14."
    },
    "source": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/source_ref",
      "description": "Source-file location: path relative to the project root plus an optional line number."
    },
    "symbol": {
      "type": "object",
      "description": "The symbol view itself: pin placement, outline and display toggles.",
      "additionalProperties": false,
      "required": [
        "library",
        "name",
        "units",
        "pin_numbers_hidden",
        "pin_names_hidden",
        "power",
        "in_bom",
        "on_board",
        "pins"
      ],
      "properties": {
        "rev": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s#]+$",
          "description": "The release of this file's facts (ADR-0034): the tag or commit in which they were last established. A copy whose facts diverged appends `+local.N`. Not the format version."
        },
        "library": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/lib_id",
          "description": "Owning library name (the directory under assets/symbols/ that holds the file); KiCad symbol id = <library>:<name>."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.+-]+$",
          "description": "Symbol name, unique within the library; it is a reusable view name (multiple components may share one symbol), and binding only happens at component.symbol."
        },
        "description": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/note",
          "description": "Free-text description; becomes the description in the IR."
        },
        "tags": {
          "type": "array",
          "description": "Tag list, sorted by byte order (a set; order carries no semantics).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of units. > 1 for multi-unit devices (e.g. dual op-amps); elements with `unit=0` are shared by all units."
        },
        "pin_numbers_hidden": {
          "type": "boolean",
          "description": "Whether pin numbers are hidden."
        },
        "pin_names_hidden": {
          "type": "boolean",
          "description": "Whether pin names are hidden."
        },
        "pin_name_offset_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Offset of the pin name relative to the pin endpoint; the exporter defaults to 0.508mm."
        },
        "power": {
          "type": "boolean",
          "description": "Power symbol (KiCad `(power)`)."
        },
        "in_bom": {
          "type": "boolean",
          "description": "Whether it counts toward the bill of materials."
        },
        "on_board": {
          "type": "boolean",
          "description": "Whether it appears at the board (PCB) level."
        },
        "pins": {
          "type": "array",
          "minItems": 1,
          "description": "Pin view table; pin numbers align with the component pin table.",
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/body_item"
          },
          "description": "Symbol outline; excludes text (v0.1)."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "description": "Attributes (Reference / Value / Datasheet / Description etc.)."
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "description": "Symbol coordinate point; origin at the symbol center, +x right, +y up.",
      "additionalProperties": false,
      "required": [
        "x_nm",
        "y_nm"
      ],
      "properties": {
        "x_nm": {
          "type": "integer",
          "description": "x coordinate, nanometers."
        },
        "y_nm": {
          "type": "integer",
          "description": "y coordinate, nanometers."
        }
      }
    },
    "position": {
      "type": "object",
      "description": "Point with orientation: coordinates plus a rotation angle.",
      "additionalProperties": false,
      "required": [
        "x_nm",
        "y_nm"
      ],
      "properties": {
        "x_nm": {
          "type": "integer",
          "description": "x coordinate, nanometers."
        },
        "y_nm": {
          "type": "integer",
          "description": "y coordinate, nanometers."
        },
        "rotation_mdeg": {
          "type": "integer",
          "description": "Rotation angle, millidegrees."
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "at",
        "length_nm",
        "unit",
        "style"
      ],
      "properties": {
        "number": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/pin_number",
          "description": "Pin number; at export time the name and electrical type are looked up in the component by this number."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "Pin connection point; rotation is the orientation (0 right, 90 up, 180 left, 270 down)."
        },
        "length_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Pin length, nanometers (the drawn segment, excluding the connection point)."
        },
        "unit": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = shared by all units."
        },
        "style": {
          "enum": [
            "line",
            "inverted",
            "clock",
            "inverted_clock",
            "input_low",
            "clock_low",
            "output_low",
            "edge_clock_high",
            "non_logic"
          ],
          "description": "Pin graphic style, e.g. line, inverted, clock, non_logic."
        }
      }
    },
    "body_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line",
            "rect",
            "circle",
            "arc",
            "poly"
          ],
          "description": "Outline element kind, e.g. line, rect, circle, arc, poly."
        },
        "unit": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = shared by all units."
        },
        "width_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Line width; 0 = no outline stroke."
        },
        "start": {
          "$ref": "#/$defs/point",
          "description": "Start-point coordinates (used by line/rect/poly)."
        },
        "end": {
          "$ref": "#/$defs/point",
          "description": "End-point coordinates (used by line/rect)."
        },
        "mid": {
          "$ref": "#/$defs/point",
          "description": "Midpoint of the arc."
        },
        "center": {
          "$ref": "#/$defs/point",
          "description": "Center coordinates of the circle/arc."
        },
        "radius_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Radius of the circle, nanometers."
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "description": "Polygon vertex list, a closed outline, at least three points.",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "fill": {
          "enum": [
            "none",
            "outline",
            "background"
          ],
          "description": "KiCad fill type; only rect/circle/poly can be filled."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line",
                "description": "Conditional field: kind is fixed to line."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rect",
                "description": "Conditional field: kind is fixed to rect."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle",
                "description": "Conditional field: kind is fixed to circle."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "center",
              "radius_nm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "arc",
                "description": "Conditional field: kind is fixed to arc."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "mid",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poly",
                "description": "Conditional field: kind is fixed to poly."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "fill": {
                "enum": [
                  "outline",
                  "background"
                ],
                "description": "Conditional field: fill is outline or background."
              }
            },
            "required": [
              "fill"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "rect",
                  "circle",
                  "poly"
                ],
                "description": "Conditional field: only rect, circle and poly may be filled."
              }
            }
          }
        }
      ]
    },
    "text_effects": {
      "type": "object",
      "description": "Text font size and effects.",
      "additionalProperties": false,
      "properties": {
        "width_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Character width, nanometers."
        },
        "height_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Character height, nanometers."
        }
      }
    },
    "field": {
      "type": "object",
      "description": "Symbol attribute (replaceable text such as designator, value).",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Attribute name, e.g. Reference / Value / Datasheet."
        },
        "value": {
          "type": "string",
          "description": "Attribute text content."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "Attribute text anchor position."
        },
        "hide": {
          "type": "boolean",
          "description": "Whether this attribute is hidden."
        },
        "effects": {
          "$ref": "#/$defs/text_effects",
          "description": "Font size and effects of the attribute text."
        }
      }
    }
  }
}
