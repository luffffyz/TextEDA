{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.14:footprint",
  "title": "TextEDA IR v0.14 — footprint",
  "description": "One footprint of a self-built footprint library: the canonical description. This is the **source of truth**; the KiCad .kicad_mod is an export artifact (ADR-0011). Lengths are always integer nanometers, angles integer millidegrees (ADR-0008); the origin is the footprint center, +x right, +y down (KiCad convention).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "footprint"
  ],
  "properties": {
    "ir_version": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/ir_version",
      "description": "IR contract version, currently always 0.14."
    },
    "source": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/source_ref",
      "description": "Source-file location: path relative to the project root plus an optional line number."
    },
    "footprint": {
      "type": "object",
      "description": "The footprint itself: pads, graphics, attributes, the package code and the 3D model reference.",
      "additionalProperties": false,
      "required": [
        "library",
        "name",
        "pads"
      ],
      "properties": {
        "rev": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s#]+$",
          "description": "The release of this file's facts (ADR-0049): the tag or commit in which they were last established. A copy whose facts diverged appends `+local.N`. Not the format version."
        },
        "library": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/lib_id",
          "description": "Owning library name (the directory under assets/footprints/ that holds the file); KiCad footprint id = <library>:<name>."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.+-]+$",
          "description": "Footprint name, e.g. ti-sot-23-5. Unique within the library."
        },
        "package_code": {
          "type": "string",
          "minLength": 1,
          "description": "The package code of this land pattern, e.g. 0402, SOT-23-5, LQFP-100 (ADR-0029 decision 1). The device does not restate it."
        },
        "description": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/note",
          "description": "Free-text description; becomes the description in the IR."
        },
        "tags": {
          "type": "array",
          "description": "Tag list, sorted by byte order (a set; order carries no semantics).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attr": {
          "type": "array",
          "items": {
            "enum": [
              "smd",
              "through_hole",
              "virtual",
              "board_only"
            ]
          },
          "description": "KiCad (attr …) flags; by default inferred from the pads (all smd → smd)."
        },
        "pads": {
          "type": "array",
          "minItems": 1,
          "description": "Pad table; pad numbers in natural order; numbering must match the symbol pin numbers.",
          "items": {
            "$ref": "#/$defs/pad"
          }
        },
        "graphics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphic"
          },
          "description": "Silkscreen/assembly/solder-mask/courtyard and other graphics."
        },
        "texts": {
          "type": "array",
          "description": "Text primitives on the footprint (silkscreen/assembly markings).",
          "items": {
            "$ref": "#/$defs/text_item"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "description": "Footprint attributes (Reference / Value / Datasheet etc.)."
        },
        "model3d": {
          "$ref": "#/$defs/model3d",
          "description": "3D model reference: file path plus offset/scale/rotation."
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "description": "Planar coordinate point; origin at the footprint center, +x right, +y down.",
      "additionalProperties": false,
      "required": [
        "x_nm",
        "y_nm"
      ],
      "properties": {
        "x_nm": {
          "type": "integer",
          "description": "x coordinate, nanometers."
        },
        "y_nm": {
          "type": "integer",
          "description": "y coordinate, nanometers."
        }
      }
    },
    "position": {
      "type": "object",
      "description": "Point with orientation: coordinates plus a rotation angle.",
      "additionalProperties": false,
      "required": [
        "x_nm",
        "y_nm"
      ],
      "properties": {
        "x_nm": {
          "type": "integer",
          "description": "x coordinate, nanometers."
        },
        "y_nm": {
          "type": "integer",
          "description": "y coordinate, nanometers."
        },
        "rotation_mdeg": {
          "type": "integer",
          "description": "Rotation angle, millidegrees."
        }
      }
    },
    "size": {
      "type": "object",
      "description": "Rectangle size: width and height.",
      "additionalProperties": false,
      "required": [
        "x_nm",
        "y_nm"
      ],
      "properties": {
        "x_nm": {
          "type": "integer",
          "minimum": 1,
          "description": "Width, nanometers."
        },
        "y_nm": {
          "type": "integer",
          "minimum": 1,
          "description": "Height, nanometers."
        }
      }
    },
    "pad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "type",
        "shape",
        "at",
        "size",
        "layers"
      ],
      "properties": {
        "number": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/pin_number",
          "description": "Pad number; must match the symbol pin number (ADR-0010 decision 3)."
        },
        "type": {
          "enum": [
            "smd",
            "th"
          ],
          "description": "SMD or through-hole."
        },
        "shape": {
          "enum": [
            "rect",
            "roundrect",
            "oval",
            "circle"
          ],
          "description": "Pad shape, e.g. rect, roundrect, oval, circle."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "Pad center position; origin at the footprint center."
        },
        "size": {
          "$ref": "#/$defs/size",
          "description": "Pad size (width × height)."
        },
        "drill": {
          "$ref": "#/$defs/size",
          "description": "Through-hole drill size (required for th)."
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name"
          },
          "description": "Layers the pad is on, e.g. [\"F.Cu\",\"F.Mask\",\"F.Paste\"]; through-hole uses [\"*.Cu\",\"*.Mask\"]."
        },
        "roundrect_ratio_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000,
          "description": "Roundrect corner ratio in parts per million (0 = square, 500000 = capsule). The IR allows no floating point (ADR-0004 decision 3)."
        },
        "solder_mask_margin_nm": {
          "type": "integer",
          "description": "Solder-mask expansion relative to the pad, nanometers; may be negative."
        },
        "solder_paste_margin_nm": {
          "type": "integer",
          "description": "Solder-paste expansion relative to the pad, nanometers; may be negative."
        },
        "clearance_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Clearance distance around the pad, nanometers."
        },
        "zone_connect": {
          "enum": [
            "solid",
            "thermal",
            "none"
          ],
          "description": "Pad connection to copper pours: solid for a full connection, thermal for thermal relief spokes, none for none."
        },
        "thermal_width_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Thermal-relief spoke width, nanometers."
        },
        "thermal_gap_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Thermal-relief gap between pad and pour, nanometers."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "th",
                "description": "Conditional field: type is fixed to th."
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "drill"
            ]
          }
        }
      ]
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layer"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line",
            "rect",
            "circle",
            "arc",
            "poly"
          ],
          "description": "Graphic kind, e.g. line, rect, circle, arc, poly."
        },
        "layer": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name",
          "description": "Layer the graphic is on, e.g. F.SilkS, F.CrtYd."
        },
        "width_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Line width; 0 uses the layer default. Optional for rect/circle/poly. poly is a closed outline."
        },
        "start": {
          "$ref": "#/$defs/point",
          "description": "Start-point coordinates (used by line/rect/poly)."
        },
        "end": {
          "$ref": "#/$defs/point",
          "description": "End-point coordinates (used by line/rect)."
        },
        "mid": {
          "$ref": "#/$defs/point",
          "description": "Midpoint of the arc."
        },
        "center": {
          "$ref": "#/$defs/point",
          "description": "Center coordinates of the circle/arc."
        },
        "radius_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Radius of the circle, nanometers."
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "description": "Polygon vertex list, a closed outline, at least three points.",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "filled": {
          "type": "boolean",
          "description": "Whether it is filled (rect/circle/poly)."
        },
        "locked": {
          "type": "boolean",
          "description": "Whether editing is forbidden."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line",
                "description": "Conditional field: kind is fixed to line."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rect",
                "description": "Conditional field: kind is fixed to rect."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle",
                "description": "Conditional field: kind is fixed to circle."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "center",
              "radius_nm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "arc",
                "description": "Conditional field: kind is fixed to arc."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start",
              "mid",
              "end"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "poly",
                "description": "Conditional field: kind is fixed to poly."
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "points"
            ]
          }
        }
      ]
    },
    "text_effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Character width, nanometers."
        },
        "height_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Character height, nanometers."
        },
        "thickness_nm": {
          "type": "integer",
          "minimum": 0,
          "description": "Stroke thickness, nanometers."
        },
        "bold": {
          "type": "boolean",
          "description": "Whether the text is bold."
        },
        "italic": {
          "type": "boolean",
          "description": "Whether the text is italic."
        }
      }
    },
    "text_item": {
      "type": "object",
      "description": "One text primitive on the footprint.",
      "additionalProperties": false,
      "required": [
        "text",
        "at",
        "layer"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Text content."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "Text anchor position; origin at the footprint center."
        },
        "layer": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name",
          "description": "Layer the text is on, e.g. F.SilkS, F.Fab."
        },
        "hide": {
          "type": "boolean",
          "description": "Whether this text is hidden."
        },
        "effects": {
          "$ref": "#/$defs/text_effects",
          "description": "Font size and style effects of the text."
        }
      }
    },
    "field": {
      "type": "object",
      "description": "Footprint attribute (replaceable text such as designator, value).",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Attribute name, e.g. Reference / Value / Datasheet."
        },
        "value": {
          "type": "string",
          "description": "Attribute text content."
        },
        "at": {
          "$ref": "#/$defs/position",
          "description": "Attribute text anchor position."
        },
        "layer": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/layer_name",
          "description": "Layer the attribute is on, e.g. F.SilkS, F.Fab."
        },
        "hide": {
          "type": "boolean",
          "description": "Whether this attribute is hidden."
        },
        "effects": {
          "$ref": "#/$defs/text_effects",
          "description": "Font size and style effects of the attribute text."
        }
      }
    },
    "model3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
          "description": "3D model file path, relative to the project (.stp / .stpZ / .wrl)."
        },
        "offset_nm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer"
          },
          "description": "Offset x/y/z, nanometers."
        },
        "scale_ppm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Scale x/y/z in parts per million (1000000 = 1×). The IR allows no floating point."
        },
        "rotation_mdeg": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer"
          },
          "description": "Rotation x/y/z, millidegrees."
        }
      }
    }
  }
}
