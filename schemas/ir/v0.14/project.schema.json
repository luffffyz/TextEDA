{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.14:project",
  "title": "TextEDA IR v0.14 — project shard",
  "description": "IR projection of project.toml: human-written metadata plus the board, variant and compliance lists. Contains no circuit semantics. See ADR-0008 decision 6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "project"
  ],
  "properties": {
    "ir_version": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/ir_version",
      "description": "IR contract version, currently always 0.14."
    },
    "source": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/source_ref",
      "description": "Source-file location: path relative to the project root plus an optional line number."
    },
    "project": {
      "type": "object",
      "description": "Project metadata: name, version, authors, license and status.",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Project name."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Project version, not the language version."
        },
        "format": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/format_version",
          "description": "The .teda language version used by the project."
        },
        "description": {
          "type": "string",
          "description": "One-sentence description of the project."
        },
        "license": {
          "type": "string",
          "description": "SPDX identifier."
        },
        "status": {
          "enum": [
            "draft",
            "prototype",
            "frozen",
            "production",
            "deprecated"
          ],
          "description": "Project status: draft, prototype, frozen, production, deprecated."
        },
        "default_variant": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/slug",
          "description": "Id of the default variant; omitted when there is only one variant."
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "description": "Author list.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Author name."
              },
              "email": {
                "type": "string",
                "minLength": 3,
                "description": "Author email."
              }
            }
          }
        },
        "links": {
          "type": "object",
          "description": "External links related to the project.",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "description": "Source repository URL."
            },
            "homepage": {
              "type": "string",
              "description": "Project homepage URL."
            },
            "issues": {
              "type": "string",
              "description": "Issue tracker URL."
            }
          }
        }
      }
    },
    "boards": {
      "type": "array",
      "description": "List of boards in the project.",
      "items": {
        "$ref": "#/$defs/board"
      }
    },
    "variants": {
      "type": "array",
      "description": "Variant list (e.g. production and debug versions).",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "compliance": {
      "$ref": "#/$defs/compliance",
      "description": "Compliance declarations: applicable standards and operating temperature range."
    },
    "ext": {
      "type": "object",
      "description": "The one free-extension area; unknown top-level keys are always an error (AGENTS.md §9)."
    },
    "note": {
      "$ref": "urn:texteda:ir:0.14:common#/$defs/note",
      "description": "Free text; canonical JSON has no comments, this is the substitute."
    }
  },
  "$defs": {
    "board": {
      "type": "object",
      "description": "One board in the project.",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/slug",
          "description": "board_id, matching design/sch/<board_id>.teda and design/pcb/<board_id>.teda."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Board version, e.g. rev-A."
        },
        "title": {
          "type": "string",
          "description": "Board title."
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.14:common#/$defs/slug",
          "description": "Variant id, unique within the project."
        },
        "description": {
          "type": "string",
          "description": "Variant description, e.g. the purpose of this variant."
        },
        "dnp": {
          "type": "array",
          "items": {
            "$ref": "urn:texteda:ir:0.14:common#/$defs/slug"
          },
          "description": "component_id or instance id not to be placed; affects only the BOM and manufacturing, never connectivity (AGENTS.md §11 item 8)."
        },
        "nofit": {
          "type": "array",
          "description": "component_id or instance id not to be assembled; affects only the BOM and manufacturing, never connectivity.",
          "items": {
            "$ref": "urn:texteda:ir:0.14:common#/$defs/slug"
          }
        },
        "alternates": {
          "type": "array",
          "description": "Substitution mapping: swap one component for another.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "urn:texteda:ir:0.14:common#/$defs/slug",
                "description": "Id of the component being replaced."
              },
              "to": {
                "$ref": "urn:texteda:ir:0.14:common#/$defs/slug",
                "description": "Id of the replacement component."
              }
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standards": {
          "type": "array",
          "description": "List of applicable standards.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operating_temp": {
          "type": "object",
          "description": "Operating temperature range.",
          "additionalProperties": false,
          "required": [
            "min_mdegc",
            "max_mdegc"
          ],
          "properties": {
            "min_mdegc": {
              "type": "integer",
              "description": "Minimum operating temperature, m°C."
            },
            "max_mdegc": {
              "type": "integer",
              "description": "Maximum operating temperature, m°C."
            }
          }
        }
      }
    }
  }
}
