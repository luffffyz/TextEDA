{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.1:manifest",
  "title": "textEDA IR v0.1 — manifest 分片",
  "description": "分片清单与哈希：每个分片一个 sha256（算在 canonical JSON 字节上）；板哈希与项目哈希按规则复算，不落盘。见 ADR-0008 决策 5。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "tool_version", "shards", "source_hash"],
  "properties": {
    "ir_version": { "$ref": "urn:texteda:ir:0.1:common#/$defs/ir_version" },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "产生 IR 的工具版本；产物可追溯的另一半。"
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
            "description": "相对 dist/ir/ 的分片路径，如 boards/charger-buck/schematic.json。"
          },
          "sha256": {
            "$ref": "urn:texteda:ir:0.1:common#/$defs/sha256",
            "description": "该分片 canonical JSON 字节的 SHA-256。"
          }
        }
      }
    },
    "source_hash": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/sha256",
      "description": "项目哈希 = SHA-256(shards 按 path 排序后逐行 \"<path>:<sha256>\\n\" 拼接)。板哈希用同一规则，取该板分片子集。"
    },
    "note": { "$ref": "urn:texteda:ir:0.1:common#/$defs/note" }
  }
}
