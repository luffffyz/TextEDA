{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.1:footprint",
  "title": "textEDA IR v0.1 — 封装",
  "description": "自建封装库的一个封装：规范描述。这是**真源**；KiCad .kicad_mod 是导出产物（ADR-0011）。长度一律纳米整数、角度毫度整数（ADR-0008）；原点是封装中心，+x 向右、+y 向下（KiCad 约定）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "footprint"],
  "properties": {
    "ir_version": { "$ref": "urn:texteda:ir:0.1:common#/$defs/ir_version" },
    "source": { "$ref": "urn:texteda:ir:0.1:common#/$defs/source_ref" },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "name", "pads"],
      "properties": {
        "library": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/lib_id",
          "description": "所属库名（project.toml 的 [libs.<name>]）；KiCad 封装 id = <library>:<name>。"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.+-]+$",
          "description": "封装名，如 ti-sot-23-5。库内唯一。"
        },
        "description": { "$ref": "urn:texteda:ir:0.1:common#/$defs/note" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "attr": {
          "type": "array",
          "items": { "enum": ["smd", "through_hole", "virtual", "board_only"] },
          "description": "KiCad (attr …) 标志；缺省按 pads 推断（全是 smd → smd）。"
        },
        "pads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pad" } },
        "graphics": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphic" },
          "description": "丝印/装配/阻焊/ courtyard 等图形。"
        },
        "texts": { "type": "array", "items": { "$ref": "#/$defs/text_item" } },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "description": "封装属性（Reference / Value / Datasheet 等）。"
        },
        "model3d": { "$ref": "#/$defs/model3d" }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer" },
        "y_nm": { "type": "integer" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer" },
        "y_nm": { "type": "integer" },
        "rotation_mdeg": { "type": "integer" }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer", "minimum": 1 },
        "y_nm": { "type": "integer", "minimum": 1 }
      }
    },
    "pad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "type", "shape", "at", "size", "layers"],
      "properties": {
        "number": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/pin_number",
          "description": "焊盘号，必须与符号引脚号一致（ADR-0010 决策 3）。"
        },
        "type": { "enum": ["smd", "th"], "description": "SMD 贴片或通孔。" },
        "shape": { "enum": ["rect", "roundrect", "oval", "circle"] },
        "at": { "$ref": "#/$defs/position" },
        "size": { "$ref": "#/$defs/size" },
        "drill": { "$ref": "#/$defs/size", "description": "通孔钻孔尺寸（th 必填）。" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:texteda:ir:0.1:common#/$defs/layer_name" },
          "description": "焊盘所在层，如 [\"F.Cu\",\"F.Mask\",\"F.Paste\"]；通孔用 [\"*.Cu\",\"*.Mask\"]。"
        },
        "roundrect_ratio_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000,
          "description": "roundrect 圆角比例，百万分比（0=方，500000=胶囊）。IR 不允许浮点（ADR-0004 决策 3）。"
        },
        "solder_mask_margin_nm": { "type": "integer" },
        "solder_paste_margin_nm": { "type": "integer" },
        "clearance_nm": { "type": "integer", "minimum": 0 },
        "zone_connect": { "enum": ["solid", "thermal", "none"] },
        "thermal_width_nm": { "type": "integer", "minimum": 0 },
        "thermal_gap_nm": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "th" } }, "required": ["type"] },
          "then": { "required": ["drill"] }
        }
      ]
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "layer"],
      "properties": {
        "kind": { "enum": ["line", "rect", "circle", "arc", "poly"] },
        "layer": { "$ref": "urn:texteda:ir:0.1:common#/$defs/layer_name" },
        "width_nm": { "type": "integer", "minimum": 0, "description": "线宽；0 用层默认。rect/circle/poly 可省。poly 是闭合轮廓。" },
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "mid": { "$ref": "#/$defs/point", "description": "arc 的中点。" },
        "center": { "$ref": "#/$defs/point" },
        "radius_nm": { "type": "integer", "minimum": 0 },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } },
        "filled": { "type": "boolean" },
        "locked": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "line" } }, "required": ["kind"] },
          "then": { "required": ["start", "end"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rect" } }, "required": ["kind"] },
          "then": { "required": ["start", "end"] }
        },
        {
          "if": { "properties": { "kind": { "const": "circle" } }, "required": ["kind"] },
          "then": { "required": ["center", "radius_nm"] }
        },
        {
          "if": { "properties": { "kind": { "const": "arc" } }, "required": ["kind"] },
          "then": { "required": ["start", "mid", "end"] }
        },
        {
          "if": { "properties": { "kind": { "const": "poly" } }, "required": ["kind"] },
          "then": { "required": ["points"] }
        }
      ]
    },
    "text_effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_nm": { "type": "integer", "minimum": 0 },
        "height_nm": { "type": "integer", "minimum": 0 },
        "thickness_nm": { "type": "integer", "minimum": 0 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" }
      }
    },
    "text_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "at", "layer"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "at": { "$ref": "#/$defs/position" },
        "layer": { "$ref": "urn:texteda:ir:0.1:common#/$defs/layer_name" },
        "hide": { "type": "boolean" },
        "effects": { "$ref": "#/$defs/text_effects" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "属性名，如 Reference / Value / Datasheet。" },
        "value": { "type": "string" },
        "at": { "$ref": "#/$defs/position" },
        "layer": { "$ref": "urn:texteda:ir:0.1:common#/$defs/layer_name" },
        "hide": { "type": "boolean" },
        "effects": { "$ref": "#/$defs/text_effects" }
      }
    },
    "model3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
          "description": "3D 模型文件路径，项目相对（.stp / .stpZ / .wrl）。"
        },
        "offset_nm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer" },
          "description": "偏移 x/y/z，纳米。"
        },
        "scale_ppm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 1 },
          "description": "缩放 x/y/z，百万分比（1000000 = 1 倍）。IR 不允许浮点。"
        },
        "rotation_mdeg": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer" },
          "description": "旋转 x/y/z，毫度。"
        }
      }
    }
  }
}
