{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.1:component",
  "title": "textEDA IR v0.1 — component 分片",
  "description": "一个 .teda component 文件的语义投影。引脚在 IR 里必须已物化：内联的照抄；`symbol` 指向自带引脚事实的第三方库、文件省略 `pins` 时由解析器从库展开，`pins_source` 记录来源。自建 `symbol` 只存视图、不带引脚事实（ADR-0012），所以指向自建符号的器件必须内联 `pins`。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "component"
  ],
  "properties": {
    "ir_version": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/ir_version"
    },
    "format": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/format_version"
    },
    "source": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/source_ref"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package",
        "symbol",
        "footprint",
        "pins",
        "pins_source"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/slug",
          "description": "等于文件名（去扩展名），不是相对路径。"
        },
        "mpn": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "开放取值集：mcu / resistor / capacitor / inductor / led / diode / mosfet_p / regulator / battery_charger / …。只做分类与免 mpn 判定。"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "datasheet": {
          "type": "string"
        },
        "lcsc": {
          "type": "string",
          "pattern": "^C[0-9]+$",
          "description": "嘉立创商城料号，见 ADR-0006。"
        },
        "symbol": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/library_ref"
        },
        "footprint": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/library_ref"
        },
        "params": {
          "type": "array",
          "description": "声明 instances 行允许的额外列，顺序即列序；required 必须排在 optional 之前（teda.md §12）。",
          "items": {
            "$ref": "#/$defs/param_decl"
          }
        },
        "pins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "pins_source": {
          "enum": [
            "inline",
            "symbol"
          ],
          "description": "inline = 文件里有 pins 段（内联优先）；symbol = 文件省略 pins，引脚从自带引脚事实的第三方库解析（自建 symbol 不带引脚事实，不能成为这个来源）。两者同时存在时取 inline，差异由校验报告输出，不进 IR。"
        }
      }
    },
    "note": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/note"
    }
  },
  "$defs": {
    "param_decl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/param_type"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "param_type": {
      "enum": [
        "resistance",
        "capacitance",
        "inductance",
        "voltage",
        "current",
        "power",
        "frequency",
        "length",
        "temperature",
        "percent",
        "integer",
        "string"
      ],
      "description": "参数类型决定 IR 里的整数单位：resistance→µΩ、capacitance→fF、inductance→pH、voltage→µV、current→nA、power→µW、frequency→mHz、length→nm、temperature→m°C、percent→ppm、integer→1。见 ADR-0008 决策 4。"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "electrical_type"
      ],
      "properties": {
        "number": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/pin_number",
          "description": "与封装 pad 对应的键；是身份的一部分。"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+-]+$",
          "description": "功能名，人可读；复用功能写在 alternates。"
        },
        "electrical_type": {
          "$ref": "#/$defs/electrical_type"
        },
        "unit": {
          "type": "integer",
          "minimum": 1,
          "description": "多单元器件的单元号；缺省 1。"
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+-]+$"
          },
          "description": "复用功能名，如 GPIO0/BOOT 里的 BOOT。"
        }
      }
    },
    "electrical_type": {
      "enum": [
        "input",
        "output",
        "bidirectional",
        "tri_state",
        "passive",
        "power_in",
        "power_out",
        "power",
        "open_collector",
        "open_emitter",
        "no_connect",
        "unspecified"
      ]
    }
  }
}
