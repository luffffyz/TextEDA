{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.1:project",
  "title": "textEDA IR v0.1 — project 分片",
  "description": "project.toml 的 IR 投影：人写的元数据 + 板/变体/库/合规清单。不含任何电路语义。见 ADR-0008 决策 6。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "project"
  ],
  "properties": {
    "ir_version": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/ir_version"
    },
    "source": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/source_ref"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "项目版本，不是语言版本。"
        },
        "format": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/format_version"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "description": "SPDX 标识。"
        },
        "status": {
          "enum": [
            "draft",
            "prototype",
            "frozen",
            "production",
            "deprecated"
          ]
        },
        "default_variant": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "homepage": {
              "type": "string"
            },
            "issues": {
              "type": "string"
            }
          }
        }
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/board"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "libs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lib"
      }
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "ext": {
      "type": "object",
      "description": "唯一的自由扩展区；未知顶层键一律报错（AGENTS.md §9）。"
    },
    "note": {
      "$ref": "urn:texteda:ir:0.1:common#/$defs/note"
    }
  },
  "$defs": {
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
        },
        "description": {
          "type": "string"
        },
        "dnp": {
          "type": "array",
          "items": {
            "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
          },
          "description": "不贴的 component_id 或实例 id；只影响 BOM 与制造，不改变连通性（AGENTS.md §11 第 8 条）。"
        },
        "nofit": {
          "type": "array",
          "items": {
            "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
          }
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
              },
              "to": {
                "$ref": "urn:texteda:ir:0.1:common#/$defs/slug"
              }
            }
          }
        }
      }
    },
    "lib": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/lib_id"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "库来源：上游名或地址（kicad-official、仓库 URL），项目自建库写 project。"
        },
        "rev": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
          "description": "只有一个根的自建库的项目相对目录（旧写法），如 footprints/project。两个根时用 symbols + footprints。"
        },
        "symbols": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
          "description": "项目自建库的符号目录（项目相对路径），如 symbols/project。与 footprints 共用同一个 <lib>: 命名空间，见 ADR-0010 补充与 ADR-0012。"
        },
        "footprints": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
          "description": "项目自建库的封装目录（项目相对路径），如 footprints/project。"
        },
        "content_hash": {
          "$ref": "urn:texteda:ir:0.1:common#/$defs/sha256",
          "description": "自建库的内容哈希：SHA-256(库目录内文件按相对路径排序后逐行 \"<relpath>:<file_sha256>\\n\" 拼接)。见 ADR-0010 决策 2。"
        }
      },
      "anyOf": [
        {
          "required": [
            "rev"
          ]
        },
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "content_hash"
          ]
        }
      ],
      "description": "库锁定：必须有 rev、version、content_hash 之一，保证可复现。自建库用 symbols/footprints（或旧写法 path）+ content_hash。"
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operating_temp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_mdegc",
            "max_mdegc"
          ],
          "properties": {
            "min_mdegc": {
              "type": "integer"
            },
            "max_mdegc": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
