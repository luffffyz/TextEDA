{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texteda:ir:0.2:pcb",
  "title": "TextEDA IR v0.2 — pcb shard",
  "description": "Physical facts and rule intent of one board (layer B0). No drawing parameters, silkscreen layout, fill caches or UUIDs; connectivity is decided by connect and the schematic and is never back-derived from geometry. See ADR-0003, spec/pcb.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "format", "board", "board_thickness_nm", "stackup", "outline", "place", "connect", "rules"],
  "properties": {
    "ir_version": { "$ref": "urn:texteda:ir:0.2:common#/$defs/ir_version" },
    "format": { "$ref": "urn:texteda:ir:0.2:common#/$defs/format_version" },
    "source": { "$ref": "urn:texteda:ir:0.2:common#/$defs/source_ref" },
    "board": { "$ref": "urn:texteda:ir:0.2:common#/$defs/slug" },
    "board_thickness_nm": {
      "type": "integer",
      "minimum": 1,
      "description": "Total board thickness; matches the sum of the stackup layer thicknesses (solder-mask and silkscreen layers excluded)."
    },
    "stackup": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/stackup_layer" },
      "description": "Order is top to bottom; not sorted. The first and last entries must be copper layers."
    },
    "outline": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" },
      "description": "Closed board-outline polyline (closed automatically from first to last); only polylines are supported. The coordinate origin is the lower-left corner of the outline's bounding box."
    },
    "place": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement" }
    },
    "connect": {
      "type": "array",
      "items": { "$ref": "#/$defs/connect_edge" },
      "description": "Explicitly declares which two pads have continuous copper between them — one of the sources of truth for connectivity."
    },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/$defs/trace" }
    },
    "via": {
      "type": "array",
      "items": { "$ref": "#/$defs/via" }
    },
    "zone": {
      "type": "array",
      "items": { "$ref": "#/$defs/zone" }
    },
    "keepout": {
      "type": "array",
      "items": { "$ref": "#/$defs/keepout" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "description": "Design rules must enter the IR: KiCad keeps them in the project file rather than the board file, so an agent holding only the .kicad_pcb cannot check them itself."
    },
    "silk": {
      "type": "array",
      "items": { "$ref": "#/$defs/silk" }
    },
    "physical_only": {
      "type": "array",
      "items": { "$ref": "#/$defs/physical_only" }
    },
    "deviation": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "note": { "$ref": "urn:texteda:ir:0.2:common#/$defs/note" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer" },
        "y_nm": { "type": "integer" }
      }
    },
    "stackup_layer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "type", "thickness_nm", "kind"],
          "properties": {
            "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
            "type": { "const": "copper" },
            "thickness_nm": { "type": "integer", "minimum": 1 },
            "kind": { "enum": ["signal", "power", "plane"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "type", "thickness_nm", "material"],
          "properties": {
            "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
            "type": { "const": "dielectric" },
            "thickness_nm": { "type": "integer", "minimum": 1 },
            "material": { "type": "string", "minLength": 1 },
            "er_ppm": {
              "type": "integer",
              "minimum": 1000000,
              "description": "Dielectric constant × 10^6, e.g. FR4 4.3 = 4300000; omitted means unknown."
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "x_nm", "y_nm", "rot_mdeg", "side"],
      "properties": {
        "instance_id": { "$ref": "urn:texteda:ir:0.2:common#/$defs/instance_id" },
        "x_nm": { "type": "integer" },
        "y_nm": { "type": "integer" },
        "rot_mdeg": {
          "type": "integer",
          "description": "Clockwise positive, millidegrees; reduced modulo 360000."
        },
        "side": { "enum": ["top", "bottom"] }
      }
    },
    "connect_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "urn:texteda:ir:0.2:common#/$defs/pad_ref" },
        "b": { "$ref": "urn:texteda:ir:0.2:common#/$defs/pad_ref" }
      },
      "description": "A pad pair forms an edge \"connected by copper\"; within each pair, byte order a ≤ b."
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "layer", "width_nm", "points"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
        "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
        "width_nm": { "type": "integer", "minimum": 1 },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "via": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "x_nm", "y_nm", "size_nm", "drill_nm"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
        "x_nm": { "type": "integer" },
        "y_nm": { "type": "integer" },
        "size_nm": { "type": "integer", "minimum": 1 },
        "drill_nm": { "type": "integer", "minimum": 1 },
        "from_layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
        "to_layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" }
      },
      "dependentRequired": {
        "from_layer": ["to_layer"],
        "to_layer": ["from_layer"]
      },
      "description": "Omitting from_layer/to_layer means a through hole; when given, it is a blind/buried via."
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net", "layer", "points"],
      "properties": {
        "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
        "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "description": "Only the intent is stored (outline + net + layer); the fill result never enters the IR and is recomputed from the outline + rules."
    },
    "keepout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "layer", "points"],
      "properties": {
        "type": { "enum": ["no_track", "no_pour", "no_place", "no_via"] },
        "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": { "const": "clearance" },
            "value_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": { "const": "width" },
            "value_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "size_nm", "drill_nm"],
          "properties": {
            "type": { "const": "via" },
            "size_nm": { "type": "integer", "minimum": 1 },
            "drill_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net", "clearance_nm", "width_nm", "via_size_nm", "via_drill_nm"],
          "properties": {
            "type": { "const": "net" },
            "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "clearance_nm": { "type": "integer", "minimum": 1 },
            "width_nm": { "type": "integer", "minimum": 1 },
            "via_size_nm": { "type": "integer", "minimum": 1 },
            "via_drill_nm": { "type": "integer", "minimum": 1 }
          },
          "description": "Overrides the default per net; the value must be written out in full — there is no \"inherit\"."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b", "impedance_mohm", "gap_nm"],
          "properties": {
            "type": { "const": "diff" },
            "net_a": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "impedance_mohm": { "type": "integer", "minimum": 1 },
            "gap_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b", "max_delta_nm"],
          "properties": {
            "type": { "const": "match" },
            "net_a": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "max_delta_nm": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expansion_nm"],
          "properties": {
            "type": { "const": "mask" },
            "expansion_nm": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ratio_ppm", "offset_nm"],
          "properties": {
            "type": { "const": "paste" },
            "ratio_ppm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "offset_nm": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "gap_nm", "bridge_nm"],
          "properties": {
            "type": { "const": "thermal" },
            "gap_nm": { "type": "integer", "minimum": 1 },
            "bridge_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value_nm"],
          "properties": {
            "type": { "const": "min_width" },
            "value_nm": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "silk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "layer", "size_nm", "mode"],
      "properties": {
        "item": { "enum": ["refdes", "value"] },
        "layer": { "enum": ["F.SilkS", "B.SilkS"] },
        "size_nm": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["show", "hide"] }
      },
      "description": "Declares only whether it appears, how large it is and on which layer; layout position never enters the IR."
    },
    "physical_only": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "size_nm", "drill_nm"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
            "type": { "const": "mounting" },
            "size_nm": { "type": "integer", "minimum": 1 },
            "drill_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "size_nm", "layer"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
            "type": { "const": "fiducial" },
            "size_nm": { "type": "integer", "minimum": 1 },
            "layer": { "$ref": "urn:texteda:ir:0.2:common#/$defs/layer_name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "net", "size_nm"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
            "type": { "const": "test_point" },
            "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "size_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "net", "size_nm", "drill_nm"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
            "type": { "const": "stitching" },
            "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "size_nm": { "type": "integer", "minimum": 1 },
            "drill_nm": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "x_nm", "y_nm", "w_nm", "h_nm"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
            "type": { "const": "cutout" },
            "x_nm": { "type": "integer" },
            "y_nm": { "type": "integer" },
            "w_nm": { "type": "integer", "minimum": 1 },
            "h_nm": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "deviation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net_a", "net_b"],
          "properties": {
            "type": { "const": "net_tie" },
            "net_a": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" },
            "net_b": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" }
          },
          "description": "Two sch nets are physically shorted together."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "net"],
          "properties": {
            "type": { "const": "split_ground" },
            "net": { "$ref": "urn:texteda:ir:0.2:common#/$defs/net_id" }
          },
          "description": "One sch net is physically split into mutually disconnected regions."
        }
      ]
    }
  }
}
