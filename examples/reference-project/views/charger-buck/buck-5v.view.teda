version 0.7
view buck-5v

# TPS5430 5V/3A buck print page. Every net is drawn as wires; GND runs as a bus below the parts
# (the view layer has no ground-symbol primitive). Ports sit on the wires they name.
#
# The buck is module M2 of the board, so the page names the board's flat ids: M2.U1, M2.C2, ...
# (spec/module.md §7).
place
  M2.C1  120.0  95.0  90
  M2.C2  170.0  88.0  0
  M2.C3  205.0  95.0  90
  M2.C4  225.0  95.0  90
  M2.D1  170.0  115.0  90
  M2.L1  185.0  100.0  0
  M2.R1  230.0  150.0  90
  M2.R2  230.0  170.0  90
  M2.U1  140.0  105.0  0

wire
  GND      M2.C1.2  M2.U1.6  120.0 120.0  137.5 120.0
  GND      M2.C3.2  M2.C4.2  205.0 120.0  225.0 120.0
  GND      M2.C4.2  M2.R2.2  225.0 120.0  238.0 120.0  238.0 173.8
  GND      M2.D1.2  M2.C3.2  170.0 120.0  205.0 120.0
  GND      M2.U1.9  M2.U1.6  142.5 120.0  137.5 120.0  137.5 112.6
  M2.BOOT  M2.U1.1  M2.C2.1  157.0 108.8  157.0 88.0
  M2.PH    M2.C2.2  M2.L1.1  173.8 100.0
  M2.PH    M2.D1.1  M2.L1.1  170.0 100.0
  M2.PH    M2.U1.8  M2.L1.1  165.0 101.2  165.0 100.0
  M2.VFB   M2.R1.2  M2.R2.1
  M2.VFB   M2.U1.4  M2.R1.2  110.0 111.3  110.0 153.8  230.0 153.8
  SYS      M2.C1.1  M2.U1.7  120.0 90.0  140.0 90.0
  VOUT     M2.C3.1  M2.C4.1
  VOUT     M2.C4.1  M2.R1.1  240.0 91.2  240.0 146.2
  VOUT     M2.L1.2  M2.C3.1  195.0 100.0  195.0 91.2

label
  GND      120.0  110.0
  GND      125.0  120.0
  GND      190.0  120.0
  GND      220.0  120.0
  GND      238.0  160.0
  M2.BOOT  157.0  100.0
  M2.PH    165.0  100.0
  M2.VFB   150.0  153.8
  SYS      130.0  90.0
  VOUT     195.0  95.0

port
  GND      137.5  117.6  180
  VOUT_5V  240.0  146.2

text
  20.0  15.0  5V 3A buck from SYS (TPS5430)
