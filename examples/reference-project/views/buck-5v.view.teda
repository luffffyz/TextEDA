version 0.14.0
view buck-5v

# TPS5430 5V/3A buck print page. Every net of this module is drawn here, and the project's two
# ports that this page draws — GND and VOUT_5V — are drawn as ports, so the page shows the
# interface it exposes as well as the wiring behind it (spec/schematic-view.md §5, ADR-0062).
#
# The buck is project module instance M2, so the page names the project's flat ids: M2.U1, M2.C2, ...
# (spec/module.md §7). Every symbol origin and every bend below is a multiple of 0.5 mm (ADR-0057),
# so a pin point is reachable by an axis-aligned run.
#
# GND is a bus below the parts at y = 121.5. Each part drops onto it in its own column, so no two
# legs share a column and each leg is a straight vertical that stops at the pin. The seven junctions
# are the points on the bus where a third arm leaves it; a part that reaches the bus with one elbow
# is a bend inside its own row, not a junction, and a dot is drawn only where one is declared
# (spec/schematic-view.md §5.1).
#
# PH is a two-point bus at y = 98.0: C2.2 sits on it, L1.1 climbs onto it at x = 181.5 and runs
# east into the pin along the pin's axis, and D1.1 climbs to it at x = 176.5, where the junction
# is.
#
# VOUT is a chain along y = 101.5 from x = 199.0 east to C3.1, C4.1 and on to the port. L1's
# output and the divider's top pin meet at R1.1, half a millimetre above that chain, and step
# onto it east of R1's body. A pin is a join: two runs that end at one pin read as one node. A
# run that ends on a pin along its axis leaves the pin visible; where three arms meet at a
# pin, the renderer draws the dot (spec/schematic-view.md §5).
#
# Different-net crossings carry no dot and are legal (spec/schematic-view.md §5.1). The feedback
# run at y = 115 crosses the three GND legs of U1.6, U1.9 and D1.2, and nothing else.
place
  M2.C1  [117.5,96.5]  90
  M2.C2  [161.5,102.0]  270
  M2.C3  [213.5,105.5]  90
  M2.C4  [218.0,105.5]  90
  M2.D1  [176.5,108.5]  90
  M2.L1  [186.5,95.5]  0
  M2.R1  [197.0,105.0]  90
  M2.R2  [197.0,115.5]  90
  M2.U1  [140.0,105.0]  0

field
  M2.C3  Reference  [2.0,-3.0]
  M2.C4  Reference  [-2.0,-2.0]

junction
  J_GND_C1   [117.5,121.5]
  J_GND_C3   [213.5,121.5]
  J_GND_D1   [176.5,121.5]
  J_GND_R2   [197.0,121.5]
  J_GND_U16  [139.5,121.5]
  J_GND_U19  [142.0,121.5]
  J_PH_D1    [176.5,98.0]

wire
  GND  GND  J_GND_C1
  GND  J_GND_C1  J_GND_U16
  GND  J_GND_D1  J_GND_R2
  GND  J_GND_R2  J_GND_C3
  GND  J_GND_U16  J_GND_U19
  GND  J_GND_U19  J_GND_D1
  GND  M2.C1.2  J_GND_C1
  GND  M2.C3.2  J_GND_C3
  GND  M2.C4.2  J_GND_C3  [218.0,121.5]
  GND  M2.D1.2  J_GND_D1
  GND  M2.R2.2  J_GND_R2
  GND  M2.U1.6  J_GND_U16
  GND  M2.U1.9  J_GND_U19
  M2.BOOT  M2.C2.1  M2.U1.1  [161.5,108.5]
  M2.PH  J_PH_D1  M2.L1.1  [181.5,98.0]  [181.5,95.5]
  M2.PH  M2.C2.2  J_PH_D1
  M2.PH  M2.D1.1  J_PH_D1
  M2.PH  M2.U1.8  M2.C2.2  [158.0,101.0]  [158.0,98.0]
  M2.VFB  M2.R1.2  M2.R2.1
  M2.VFB  M2.U1.4  M2.R2.1  [120.0,106.0]  [120.0,115.0]  [190.0,115.0]  [190.0,111.5]
  SYS  M2.C1.1  M2.U1.7  [117.5,89.5]  [140.0,89.5]
  VOUT  M2.C3.1  M2.C4.1
  VOUT  M2.C4.1  VOUT_5V
  VOUT  M2.L1.2  M2.R1.1  [193.0,95.5]  [193.0,101.0]
  VOUT  M2.R1.1  M2.C3.1  [199.0,101.0]  [199.0,101.5]

label
  GND      [160.0,121.5]
  M2.BOOT  [158.0,108.5]
  M2.PH    [168.0,98.0]
  M2.VFB   [150.0,115.0]
  SYS      [130.0,89.5]
  VOUT     [205.0,101.5]

port
  GND      [110.0,121.5]  180
  VOUT_5V  [233.0,101.5]
