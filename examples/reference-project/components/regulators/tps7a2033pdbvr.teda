version 0.1
component tps7a2033pdbvr

# 3.3V/300mA LDO, SOT-23-5 (DBV). Per TI SBVS348H (TPS7A20) section 4 Pin Functions:
# SOT-23 package: IN=1 / GND=2 / EN=3 / N/C=4 / OUT=5.
# KiCad official library has no TPS7A20 symbol; the pin-identical TPS7A02 symbol is used here as the view.
mpn          TPS7A2033PDBVR
manufacturer Texas Instruments
category     regulator
package      SOT-23-5
datasheet    https://www.ti.com/lit/ds/symlink/tps7a20.pdf

symbol project:ldo-sot23-5
footprint project:sot-23-5

pins
  1  IN   power_in
  2  GND  power
  3  EN   input
  4  NC   no_connect
  5  OUT  power_out
