version 0.1
component tps7a2033pdbvr

# 3.3V/300mA LDO，SOT-23-5 (DBV)。依据 TI SBVS348H (TPS7A20) 第 4 节 Pin Functions：
# SOT-23 封装 IN=1 / GND=2 / EN=3 / N/C=4 / OUT=5。
# KiCad 官方库无 TPS7A20 符号，此处用引脚完全一致的 TPS7A02 符号作视图。
mpn          TPS7A2033PDBVR
manufacturer Texas Instruments
category     regulator
package      SOT-23-5
datasheet    https://www.ti.com/lit/ds/symlink/tps7a20.pdf

symbol project:ldo-sot23-5
footprint project:sot-23-5

pins
  1  IN   power_in
  2  GND  power
  3  EN   input
  4  NC   no_connect
  5  OUT  power_out
