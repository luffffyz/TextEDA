version 0.3
page buck-5v

# TPS5430 5V/3A step-down from the charger SYS rail.
# Component values follow datasheet SLVS632 Figure 7-1 (12V to 5V, 3A).
# SYS is 9V..19.8V: battery 9V..12.6V or adapter up to 19.8V.
# ENA is intentionally left floating; the internal 1.5M pullup enables the device.
# Second page of the charger-buck board: input SYS is wired from the board root to the charger-power page's SYS_OUT.
instances
  C1  c-1210       10u    10%  35V
  C2  c-0402       10n    10%  25V
  C3  c-220u       220u   20%  10V  40mΩ
  C4  c-0402       100n   10%  16V
  D1  d-b340a
  L1  l-15u
  R1  r-0402       10k    ±1%
  R2  r-0402       3.24k  ±1%
  U1  tps5430ddar

nets
  BOOT:  C2.1  U1.BOOT
  GND:   C1.2  C3.N  C4.2  D1.A  R2.2  U1.GND  U1.PAD
  PH:    C2.2  D1.K  L1.1  U1.PH
  SYS:   C1.1  U1.VIN
  VFB:   R1.2  R2.1  U1.VSENSE
  VOUT:  C3.P  C4.1  L1.2  R1.1

ports
  GND     GND
  SYS_IN  SYS
  VOUT    VOUT

constraints
  voltage  SYS   9V..19.8V
  voltage  VOUT  4.85V..5.15V
  voltage  VFB   1.203V..1.239V
  current  VOUT  3A
