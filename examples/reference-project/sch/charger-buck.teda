version 0.8
schematic charger-buck

# One physical board: BQ24610 charge/power path + TPS5430 5V buck, sharing one BOM and one PCB.
#
# The board composes two modules (spec/module.md): the power path and the buck. The board's own
# nets are the ones the modules' ports merge into; the modules' internal nets stay inside them
# (M1.<net> and M2.<net> in the flat IR).
#
# The drawing is partitioned separately: the print pages live in sch/charger-buck/*.view.teda.
modules
  M1  charger-power
  M2  buck-5v

nets
  AC_COMMON:  M1.AC_RET
  ADAPTER_P:  M1.DC_IN
  GND:        M1.GND  M2.GND
  SYS:        M1.SYS_OUT  M2.SYS_IN
  VBAT:       M1.BAT
  VOUT:       M2.VOUT

# The board's external interface: what the board offers to the system description.
ports
  AC_RET   AC_COMMON
  BAT      VBAT
  DC_IN    ADAPTER_P
  GND      GND
  VOUT_5V  VOUT

constraints
  voltage  SYS   9V..19.8V
  voltage  VBAT  9V..12.6V
  voltage  VOUT  4.85V..5.15V
  current  VBAT  3A
  current  VOUT  3A
