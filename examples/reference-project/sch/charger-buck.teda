version 0.3
schematic charger-buck

nets
  AC_COMMON:  M1.AC_RET
  ADAPTER_P:  M1.AC_IN
  GND:        M1.GND  M2.GND
  SYS:        M1.SYS_OUT  M2.SYS_IN
  VBAT:       M1.BAT_OUT
  VOUT:       M2.VOUT

# One physical board: BQ24610 charge/power path + TPS5430 5V buck, sharing one BOM and one PCB.
# Pages are division units inside a board (the canvas won't fit, reviews want chunks), not two boards:
# a page yields neither a separate PCB nor a separate BOM.
# Board-level nets reach pages only through page ports (M1.AC_IN etc.); the board-level ports section declares this board's external terminals.
pages
  M1  charger-power
  M2  buck-5v

ports
  AC_RET   AC_COMMON
  BAT      VBAT
  DC_IN    ADAPTER_P
  GND      GND
  VOUT_5V  VOUT
