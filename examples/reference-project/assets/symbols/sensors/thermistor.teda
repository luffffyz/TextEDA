version 0.11
symbol thermistor

description NTC thermistor, 2-pin generic view
tags ntc temperature thermistor
pin_numbers hide
pin_names hide
# IEC-style thermistor: a resistor rectangle crossed by a diagonal mark with both ends bent outward.
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0074); the tails and the body follow it where that is convenient.
field Reference at=[0,2.5] U
field Value at=[0,-2.5] thermistor

pins
  1  [-4,0]  0    length=2
  2  [4,0]   180  length=2

body
  line  [-2,-1.5,2,1.5]      width=0.25
  line  [-2.5,-1.5,-2,-1.5]  width=0.25
  line  [2,1.5,2.5,1.5]      width=0.25
  rect  [-2,-1,2,1]          width=0.25
