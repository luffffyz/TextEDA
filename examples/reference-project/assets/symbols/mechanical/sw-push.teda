version 0.11
symbol sw-push

description Tactile push switch, 4-pin generic view
tags push switch tactile
# Four-pin tactile switch: one pin pair on each side, contact and button stem in the middle.
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0074); the tails and the body follow it where that is convenient.
# The two pins of a side are one contact and sit 1.0 mm apart; pin numbers are hidden because at that
# spacing their painted boxes overlap (ADR-0058).
pin_numbers hide
pin_names hide
pin_name_offset 0.5
field Reference at=[0,2.5] U
field Value at=[0,-2.5] sw-push

pins
  1  [-4,-0.5]  0
  2  [-4,0.5]   0
  3  [4,-0.5]   180
  4  [4,0.5]    180

body
  line  [-0.5,1,0.5,1]    width=0.25
  line  [-1.5,-1,-1.5,1]  width=0.25
  line  [-1.5,0.5,0,0.5]  width=0.25
  line  [0,0.5,0,1]       width=0.25
  line  [1.5,-1,1.5,1]    width=0.25
