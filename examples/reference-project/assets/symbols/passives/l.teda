# Generic inductor view: four semicircular humps along the pin axis. Shared by several components (15uH / 6.8uH etc.).
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0074). The body is artwork, not a frame: the four
# humps keep their own midpoints (0.625 / 1.25 / 1.875 mm), off the lattice by choice — a body is drawing, not a
# rule (ADR-0074 D2).
field Reference at=[0,2.5] U
field Value at=[0,-2.5] l

pins
  1  [-4,0]  0    length=1.5
  2  [4,0]   180  length=1.5

body
  arc  [-1.25,0,-0.625,0.625,0,0]     width=0.25
  arc  [-2.5,0,-1.875,0.625,-1.25,0]  width=0.25
  arc  [0,0,0.625,0.625,1.25,0]       width=0.25
  arc  [1.25,0,1.875,0.625,2.5,0]     width=0.25
