version 0.1.1
component cap-mlcc-0402

# A generic 0402 MLCC capacitor: the design says what it needs (value, tolerance, voltage), the
# procurement layer says what is bought. The package and the land pattern are fixed facts.

kind         family
category     capacitor
construction mlcc
polarized    no
package      0402

symbol project:c
footprint project:chip-0402

params
  value      capacitance required
  tolerance  percent     optional
  voltage    voltage     optional
  dielectric string      optional

pins
  1  A  passive
  2  B  passive
