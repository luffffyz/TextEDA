version 0.9.1
component tps7a2033pdbvr

# 3.3V/300mA LDO, SOT-23-5 (DBV). Per TI SBVS348H (TPS7A20) section 4 Pin Functions:
# SOT-23 package: IN=1 / GND=2 / EN=3 / N/C=4 / OUT=5.
# KiCad official library has no TPS7A20 symbol; the pin-identical TPS7A02 symbol is used here as the view.
kind         part
mpn          TPS7A2033PDBVR
manufacturer Texas Instruments
category     regulator
datasheet    https://www.ti.com/lit/ds/symlink/tps7a20.pdf

symbol project:ldo-sot23-5
footprint project:sot-23-5

# The part's own rating (ADR-0039): what the device is, not what the design asks of it.
# The input voltage limit is not recorded yet: it needs the datasheet, and this file does not cite one value.
ratings
  rated_current  current  300mA

pins
  1  IN   power_in
  2  GND  power
  3  EN   input
  4  NC   no_connect
  5  OUT  power_out
