version 0.9.2
component cap-tantalum-7343

# A polarised tantalum capacitor. The polarity is a fact of the generic, not a hint in the file
# name: the pins are typed `polarized`, so a reversed part is visible.

kind         generic
category     capacitor
construction tantalum
polarized    yes

symbol passives:c-pol
footprint tantalum:tantalum-7343
params
  value      capacitance required
  tolerance  percent     required
  voltage    voltage     required
  esr        resistance  optional

pins
  1  P  polarized
  2  N  polarized
