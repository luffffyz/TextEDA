version 0.9.1
component rc0402fr-0710kl

# 10kΩ ±1% 0402 thick-film resistor, 1/16W. The primary source for the `res-thick-0402 10k ±1%`
# BOM line of the charger-buck board (assets/procurement/primary/charger-buck.teda).
kind         part
mpn          RC0402FR-0710KL
manufacturer Yageo
category     resistor

symbol project:r
footprint project:chip-0402

# The part's own ratings (ADR-0039): what the device is, not what the design asks of it.
# The tolerance is the part's own; the value is its nominal, so its worst case is 9.9kΩ..10.1kΩ.
# The power rating is the package's (1/16W for a 0402 thick film), stated here so that a design which
# declares a dissipation limit on a 10k line can be compared against what this part can take (ADR-0044).
ratings
  value      resistance  10k
  tolerance  percent     1%
  power      power       62.5mW

pins
  1  A  passive
  2  B  passive
