version 0.9.2
component crc0402fr-0710kl

# 10kΩ ±1% 0402 thick-film resistor, 1/16W. The second source for the `res-thick-0402 10k ±1%`
# BOM line of the charger-buck board (assets/procurement/alternatives/charger-buck.teda).
kind         part
mpn          CRC0402FR-0710KL
manufacturer Vishay
category     resistor

symbol passives:r
footprint chip:chip-0402
# The part's own ratings (ADR-0026): what the device is, not what the design asks of it.
# The power rating is the package's (0.063W for a 0402 thick film), stated here so that a design which
# declares a dissipation limit on a 10k line can be compared against what this part can take (ADR-0026).
ratings
  value      resistance  10k
  tolerance  percent     1%
  power      power       63mW

pins
  1  A  passive
  2  B  passive
