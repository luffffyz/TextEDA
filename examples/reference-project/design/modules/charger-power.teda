# The module's interface: what the board may connect to it. The port names are the module's own;
# the board decides which board-level net each one lands on.
ports
  AC_RET   AC_COMMON
  BAT      VBAT
  DC_IN    ADAPTER_P
  GND      GND
  SYS_OUT  SYS

constraints
  voltage  VCC  5V..28V
  voltage  VFB  2.079V..2.121V
