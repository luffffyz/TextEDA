# The module's interface: what the board may connect to it. The port names are the module's own;
# the board decides which board-level net each one lands on.
ports
  BAT      VBAT
  DC_IN    ADAPTER_P
  GND      GND
  SYS_OUT  SYS

# A rail's reviewed maximum belongs in the PCB current rule; this old 2A net value is retained below
# as TODO(F88) for manual review. The requirement on the jack's tip remains a pin-current constraint
# checked against the jack's own rating (2A) — the jack is a generic, so the line supplies the
# requirement, and the part bought for it states 2A as well.
constraints
  voltage  VCC        5V..28V
  voltage  VFB        2.079V..2.121V
  voltage  ADAPTER_P  0V..19V
  voltage  AC_COMMON  0V..19V
  voltage  ACP        0V..19V
  voltage  AC_GATE    0V..19V
# TODO(F88): review rail ADAPTER_P maximum current 2A; add a reviewed PCB rules current row with min_width and source before enabling.
  current  J1.1       2A
# The two series positions, with the current that flows through each of them (ADR-0076): a part
# in series does not see the difference between its two nets' windows, so the current is what
# bounds its dissipation.
#   R17 feeds the charger's VCC pin: TI SLUS892D (8.5) gives IAC -- the current into VCC, ACP and
#   ACN together -- as 5 mA max when the charge is done and 25 mA max while charging. 25 mA is
#   the worst case of that sum, so it bounds the current into VCC alone.
  current  R17.1      25mA
#   R21 is the current-sense resistor between ACP and SYS: it carries the adapter current into
#   the charger's sense input; the former 2 A rail maximum is retained for manual review in TODO(F88).
  current  R21.1      2A
