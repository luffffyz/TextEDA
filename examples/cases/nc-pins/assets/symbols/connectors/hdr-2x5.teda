version 0.11
symbol hdr-2x5

# Odd pins on the left, even on the right, 2.5 apart for legibility (the real pitch is 1.27; the
# drawing is not the land pattern, and the view layer owns placement anyway).
description Debug header 2x5, ten pins
tags connector debug header
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0057) in both coordinates; rows are 2.5 mm apart (ADR-0058).
field Reference at=[0,7.5] J
field Value at=[0,-7.5] hdr-2x5

pins
  1   [-7,-5]    0
  2   [7,-5]     180
  3   [-7,-2.5]  0
  4   [7,-2.5]   180
  5   [-7,0]     0
  6   [7,0]      180
  7   [-7,2.5]   0
  8   [7,2.5]    180
  9   [-7,5]     0
  10  [7,5]      180

body
  rect  [-4.5,-6,4.5,6]  fill=background  width=0.254
