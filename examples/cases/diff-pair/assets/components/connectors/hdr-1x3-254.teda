version 0.9.2
component hdr-1x3-254

# Case fixture: a 2.54 mm 1x3 header is a part, so it carries a part number. This is a test fixture, not
# a real purchase; the pins (CANH/CANL/GND in CAN order) are the case's own model.
kind         part
mpn          HDR-1X3-254
manufacturer Fixture
category     connector
description  2.54 mm 1x3 header, through-hole

symbol connectors:hdr-1x3
footprint header:hdr-1x3-254
pins
  1  CANH    bidirectional
  2  CANL    bidirectional
  3  GND     power_in
