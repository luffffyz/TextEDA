version 0.17.0
pcb bulk-cap

# The physical board that carries the bulk capacitor. The case is about the class's polarity, not
# about the layout: the board exists, owns the module instance, and says nothing else.
board_thickness  1.6

modules
  M1

stackup
  F.Cu     copper      0.035  signal
  prepreg  dielectric  1.53   FR4     4.3
  B.Cu     copper      0.035  signal

outline
  [0,0]
  [40,0]
  [40,30]
  [0,30]

place

connect

rules
  clearance  0.2
  width  0.3
  via  0.6  0.3
