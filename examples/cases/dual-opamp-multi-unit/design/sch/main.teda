version 0.14.0
schematic main

# The project's logical root composes the dual op-amp module and binds its public ports.
modules
  M1  multi-unit

nets
  GND:      M1.GND
  SIG_IN:   M1.SIG_IN
  SIG_OUT:  M1.SIG_OUT
  V3V3:     M1.V3V3

ports
  GND      GND
  SIG_IN   SIG_IN
  SIG_OUT  SIG_OUT
  V3V3     V3V3

constraints
  voltage  GND   0V..0V
  voltage  V3V3  3.135V..3.465V
