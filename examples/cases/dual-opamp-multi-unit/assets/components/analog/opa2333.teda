version 0.1.7
component opa2333

# TI OPA2333 dual zero-drift op-amp, SOIC-8. One part, three units: A (pins 1-3), B (pins 5-7),
# power (pins 4 and 8) — the shape every dual op-amp has, and the reason a pin reference needs
# three parts (`U1.2.OUT`, teda.md §4.5): `OUT` exists in both amplifier units.
kind         part
mpn          OPA2333AIDR
manufacturer Texas Instruments
category     opamp
datasheet    https://www.ti.com/lit/ds/symlink/opa2333.pdf
description  Dual 350 kHz 5 uV zero-drift op-amp, 1.8-5.5 V, SOIC-8

symbol project:opa2333
footprint project:soic-8

pins
  1  OUT  output    unit=1
  2  IN-  input     unit=1
  3  IN+  input     unit=1
  5  IN+  input     unit=2
  6  IN-  input     unit=2
  7  OUT  output    unit=2
  4  V-   power_in  unit=3
  8  V+   power_in  unit=3
