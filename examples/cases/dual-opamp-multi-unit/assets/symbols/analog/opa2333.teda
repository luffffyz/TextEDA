version 0.11
symbol opa2333

# Three units (teda.md §4.5, spec/symbol.md §2): A and B are the amplifiers, drawn identically;
# unit 3 carries the supply pins, which belong to neither amplifier. `units 3` is what makes the
# unit column of the pins mean anything.
description Dual zero-drift op-amp, three units
tags analog dual opamp
units 3
# The device file owns the pin facts (numbers, names, electrical types); this file only draws.
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0074) in both coordinates; rows are 2.5 mm apart (ADR-0058).
field Reference at=[0,11] U
field Value at=[0,-11] opa2333

pins
  1  [5,0]     180
  2  [-5,-1]   0
  3  [-5,1.5]  0
  5  [-5,-1]   0    unit=2
  6  [-5,1.5]  0    unit=2
  4  [0,-7.5]  90   unit=3
  7  [5,0]     180  unit=3
  8  [0,7.5]   270  unit=3

body
  poly  [-2.5,-2.5,2.5,0,-2.5,2.5,-2.5,-2.5]  width=0.254
  poly  [-2.5,-2.5,2.5,0,-2.5,2.5,-2.5,-2.5]  unit=2       width=0.254
  rect  [-1.5,-2.5,1.5,2.5]                   unit=3       width=0.254
