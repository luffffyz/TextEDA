version 0.14.0
schematic main

# The project root composes the two reusable filter channels and the local thermistor.
modules
  M1  ID4xekqr           rc-filter-2stage
  M2  IDcg99hr           rc-filter-2stage
  M3  sensor-thermistor

nets
  GND:   M1.GND  M2.GND  M3.GND
  NTC:   M3.NTC
  OUT1:  M1.OUT
  OUT2:  M2.OUT
  SIG1:  M1.IN
  SIG2:  M2.IN

ports
  GND   GND
  NTC   NTC
  OUT1  OUT1
  OUT2  OUT2
  SIG1  SIG1
  SIG2  SIG2

constraints
  voltage  GND   0V..0V
  voltage  NTC   0V..3.3V
  voltage  SIG1  0V..3.3V
  voltage  SIG2  0V..3.3V
