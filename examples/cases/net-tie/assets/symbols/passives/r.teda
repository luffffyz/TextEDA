version 0.11
symbol r

description Resistor, 2-pin generic view
tags passive resistor
pin_numbers hide
pin_names hide
# Generic resistor view: the IEC rectangle, one pin on each side. Shared by several components (0402 / 2010 etc.).
# Pin connection points sit on the 0.5 mm placement lattice (ADR-0074); the tails and the body follow it where that is convenient.
field Reference at=[0,2.5] U
field Value at=[0,-2.5] r

pins
  1  [-4,0]  0    length=1.5
  2  [4,0]   180  length=1.5

body
  rect  [-2.5,-1,2.5,1]  fill=background  width=0.254
