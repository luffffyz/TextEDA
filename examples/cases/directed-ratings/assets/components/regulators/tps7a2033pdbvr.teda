version 0.11
component tps7a2033pdbvr

# 3.3V/300mA LDO, SOT-23-5 (DBV). Per TI SBVS338H (TPS7A20):
#   Pin Functions, SOT-23 package: IN = 1 / GND = 2 / EN = 3 / N/C = 4 / OUT = 5.
#   Absolute Maximum Ratings (5.1): the input voltage V_IN may not exceed 6.5 V.
# KiCad official library has no TPS7A20 symbol; the pin-identical TPS7A02 symbol is used here as the view.
kind         part
mpn          TPS7A2033PDBVR
manufacturer Texas Instruments
category     regulator
datasheet    https://www.ti.com/lit/ds/symlink/tps7a20.pdf

symbol regulators:ldo-sot23-5
footprint sot:sot-23-5

# The part's own ratings (ADR-0026): what the device is, not what the design asks of it.
# The voltage rating names no terminals: this part has five pins, so a number without a pair of
# pins cannot be checked against a pair of nets (ADR-0026 D7). The case says so out loud instead
# of letting the number read as a pass.
ratings
  rated_current  current  300mA
  voltage        voltage  6.5V

pins
  1  IN   power_in
  2  GND  power
  3  EN   input
  4  NC   no_connect
  5  OUT  power_out
